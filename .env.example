# Application Configuration
APP_NAME="UK Tutoring Platform"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/London

# Database Configuration (MySQL 8+ Source of Truth)
# Timestamps in database must be UTC
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tutoring_platform_dev
DB_USERNAME=root
DB_PASSWORD=
DB_TIMEZONE="+00:00"

# Firebase Authentication (Identity & Authentication Provider Only)
# Note: Keep service-account JSON outside source control
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=storage/credentials/firebase-service-account.json

# Transactional Email Service Configuration (EmailService Abstraction - Open Client Decision)
EMAIL_ENABLED=true
EMAIL_MAILER=log
EMAIL_FROM_ADDRESS=noreply@tutoringplatform.co.uk
EMAIL_FROM_NAME="UK Tutoring Platform"
# Optional Generic Provider Configuration (If SMTP/third-party is configured):
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=placeholder-username
EMAIL_PASSWORD=placeholder-password
EMAIL_ENCRYPTION=tls

