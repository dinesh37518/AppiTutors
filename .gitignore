# Environment and sensitive credential files
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*service-account*.json
*firebase*.json
credentials.json

# Composer dependencies
/vendor/

# Node dependencies and build artifacts
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Application runtime logs and caches
/storage/logs/*
!/storage/logs/.gitkeep
*.log

# Sensitive private storage, uploads, and credentials
/storage/credentials/*
!/storage/credentials/.gitkeep
/storage/uploads/*
!/storage/uploads/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep
/storage/private/*
!/storage/private/.gitkeep

# Operating system files
Thumbs.db
Desktop.ini
.DS_Store

# IDE and editor settings
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
